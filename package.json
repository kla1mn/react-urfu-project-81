    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.93.0",
